# Agent Forge — Environment Configuration

# === Application ===
APP_NAME=Agent Forge
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# === Gemini API ===
# Required for real LLM-powered task analysis (optional for demo — falls back to template engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# === PostgreSQL (Production) ===
# Leave DATABASE_URL blank to use local SQLite fallback (zero-config for dev)
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge_secret
POSTGRES_DB=agentforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://agentforge:agentforge_secret@localhost:5432/agentforge_db

# === Redis (Optional) ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# === Frontend (Next.js) ===
# Set in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
