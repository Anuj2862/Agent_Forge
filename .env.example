# Agent Forge — Environment Configuration

# === Application ===
APP_NAME=Agent Forge
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# === Execution Mode ===
# Options: 'real' (production execution with isolated sandbox) or 'simulation' (reproducible deterministic demo)
AGENT_FORGE_MODE=real

# === LLM Provider (Google Gemini) ===
# Required for real LLM reasoning & analysis (falls back to deterministic heuristics if unset)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# === Search Provider (Optional for live web search) ===
# If omitted or offline, web search tool reports explicit OFFLINE/UNAVAILABLE status
TAVILY_API_KEY=your_tavily_api_key_here

# === Persistence Database ===
# Default local SQLite (zero-config, persists across restarts):
AGENT_FORGE_DATABASE_URL=sqlite+aiosqlite:///./agentforge_memory.db
# PostgreSQL asyncpg URL for containerized/production deployment:
# AGENT_FORGE_DATABASE_URL=postgresql+asyncpg://agentforge:agentforge_secret@localhost:5432/agentforge_db

POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge_secret
POSTGRES_DB=agentforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Redis (Optional) ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# === Frontend (Next.js) ===
# Set in frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
